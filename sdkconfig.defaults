# JK-BMS -> MQTT Bridge, M5Stack Unit PoE-P4 (SKU U213, alte Revision)
# ESP-IDF 5.4.x / 5.5.x, Ziel: esp32p4

CONFIG_IDF_TARGET="esp32p4"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Logs ueber das USB-C-Download-Kabel (USB-Serial-JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# ---- Software-Version (fuer Releases; steht im App-Deskriptor und ist damit
# die zentrale Referenz fuer Web-UI, MQTT (<prefix>/device), Logs und den
# Online-Update-Check. Fuer ein Release NUR hier aendern!) ----
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="v0.0.10"

# ---- Laufzeit-Konfiguration (Web-UI, NVS-Partition 'cfg') ----
# Broker/Passwörter/Static-IP/TLS/Debug NICHT mehr hier eintragen -
# die gepatchten Werte leben in Partition 'cfg' und überleben OTA.
# Nur noch die URLs/das Reset-Buttons-GPIO sind Buildzeit-Optionen:
CONFIG_JKBMS_OTA_DEFAULT_URL="https://github.com/c0d3-n1nja/jk-bms-poe-p4/releases/latest/download/jkbms_mqtt_poe_p4.bin"
CONFIG_JKBMS_RESET_BUTTON_GPIO=45
CONFIG_JKBMS_TOPIC_PREFIX="jkbms"
CONFIG_JKBMS_HA_DISCOVERY=n

# ---- JK-BMS Polling ----
CONFIG_JKBMS_POLL_INTERVAL_MS=5000
CONFIG_JKBMS_CONFIG_READ_INTERVAL_MS=60000
CONFIG_JKBMS_STATE_HEARTBEAT_MS=60000
CONFIG_JKBMS_MODBUS_SLAVE_ADDR=1

# ---- OTA (Firmware via MQTT-Topic jkbms/ota, URL-Trigger) ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# ---- TEMPORARY insecure TLS (remove together with this section!) ----
# The embedded ca_cert.pem is still a placeholder, so OTA (https) and MQTTS
# skip server certificate validation until it contains the real CA chain.
# Once replaced: remove these two lines, do a fullclean build, and re-enable
# the CA attach in main/app_ota.c / main/app_mqtt.c.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# ---- RS485 (UART1, Software-DE) ----
CONFIG_JKBMS_RS485_UART_NUM=1
CONFIG_JKBMS_RS485_RX_GPIO=20
CONFIG_JKBMS_RS485_TX_GPIO=19
CONFIG_JKBMS_RS485_DE_GPIO=21

# ---- Ethernet (interne RMII EMAC + IP101GRI, Pinmap = U213 Board) ----
CONFIG_JKBMS_ETH_MDC_GPIO=31
CONFIG_JKBMS_ETH_MDIO_GPIO=52
CONFIG_JKBMS_ETH_PHY_RST_GPIO=51
CONFIG_JKBMS_ETH_PHY_ADDR=1
